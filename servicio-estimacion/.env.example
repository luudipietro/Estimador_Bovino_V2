# Copiar a .env y completar. NUNCA versionar el .env real. Detalle de cada variable: docs/arquitectura.md

# --- Obligatorias ---
TOKEN_SERVICIO=
SECRETO_HMAC=

# --- Allowlists (hosts separados por coma; vacío = no se aceptan URLs) ---
HOSTS_IMAGEN_PERMITIDOS=
HOSTS_CALLBACK_PERMITIDOS=

# --- Opcionales ---
CARPETA_MODELOS=../estimador/modelos
PRESUPUESTO_ESTIMACION_S=45
# HILOS_INFERENCIA=            # por defecto: núcleos disponibles
MAX_MB_IMAGEN=25
MAX_PIXELES=100000000         # propuesto; Pillow corta por su cuenta cerca de los 178 MP
# CARPETA_TEMPORAL=           # por defecto: <carpeta temporal del sistema>/bv_estimacion
TTL_IMAGENES_S=3600           # propuesto: respaldo para imágenes que nadie borró
RESOLUCION_MINIMA_MP=3
# UMBRAL_BORROSIDAD=           # sin valor: la regla R-24 queda desactivada hasta calibrarla
TTL_TRABAJOS_S=86400
TAMANO_COLA=200
INTENTOS_CALLBACK=3          # en total: el primero y dos reintentos
ESPERA_BASE_CALLBACK_S=1     # esperas de 1 s y 2 s entre intentos
