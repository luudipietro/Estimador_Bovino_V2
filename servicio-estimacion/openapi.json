            "type": "integer"
          },
          "motivos": {
            "items": {
              "$ref": "#/components/schemas/MotivoNoSe"
            },
            "title": "Motivos",
            "type": "array"
          },
          "peso_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peso Kg"
          }
        },
        "required": [
