          "id_evento_en_conflicto",
          "referencia_no_permitida",
          "no_autenticado",
          "trabajo_no_encontrado",
          "cola_llena",
          "solicitud_invalida",
          "modelo_no_disponible",
          "tiempo_excedido",
          "referencia_inaccesible",
          "error_interno"
        ],
        "title": "CodigoError",
        "type": "string"
      },
      "DuracionMs": {
        "properties": {
          "cola": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cola"
          },
          "inferencia": {
            "title": "Inferencia",
            "type": "integer"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          }
        },
        "required": [
          "cola",
          "inferencia",
          "total"
        ],
        "title": "DuracionMs",
        "type": "object"
      },
      "FichaModeloRespuesta": {
        "properties": {
          "fecha_entrenamiento": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` si el `config.json` del modelo no la informa",
            "title": "Fecha Entrenamiento"
          },
          "ic95_test": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ic95 Test"
          },
          "mape_test": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` si el `config.json` del modelo no lo informa",
            "title": "Mape Test"
          },
          "rango_validez_kg": {
            "description": "Fuera de este rango el peso no es confiable (R-20)",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Rango Validez Kg",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "rango_validez_kg",
          "mape_test",
          "ic95_test",
          "fecha_entrenamiento"
        ],
        "title": "FichaModeloRespuesta",
        "type": "object"
      },
      "ImagenResultado": {
        "properties": {
          "bovinos_en_la_escena": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bovinos En La Escena"
          },
          "confiable": {
