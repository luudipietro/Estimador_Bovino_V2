          "peso_kg",
          "confiable",
          "motivos",
          "confianza_deteccion",
          "confianza_keypoint_minima",
          "bovinos_en_la_escena"
        ],
        "title": "ImagenResultado",
        "type": "object"
      },
      "MotivoNoSe": {
        "description": "Por qué el modelo no puede estimar con confianza. **No es un error** (R-21): el trabajo termina\n`completado` con `confiable = false`.",
        "enum": [
          "sin_animal",
          "deteccion_dudosa",
          "partes_tapadas",
          "animal_cortado",
          "imagen_borrosa",
          "fuera_de_rango"
        ],
        "title": "MotivoNoSe",
        "type": "string"
      },
      "Problema": {
        "description": "Error en formato RFC 9457 (`application/problem+json`). Los códigos están en `docs/errores.md`.",
        "properties": {
          "campos": {
            "description": "En `solicitud_invalida`: los nombres de lo que está mal, nunca los valores recibidos",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "codigo": {
            "enum": [
              "cantidad_imagenes_invalida",
              "cola_llena",
              "error_interno",
              "formato_no_admitido",
              "id_evento_en_conflicto",
              "imagen_corrupta",
              "imagen_muy_grande",
              "modelo_no_disponible",
              "no_autenticado",
              "referencia_inaccesible",
              "referencia_no_permitida",
              "resolucion_insuficiente",
              "solicitud_invalida",
              "tiempo_excedido",
              "trabajo_no_encontrado"
            ],
            "type": "string"
          },
          "detail": {
            "description": "Texto legible. Nunca trazas ni nombres de clases",
            "type": "string"
          },
          "regla": {
            "description": "Regla de dominio involucrada (por ejemplo `R-18`), si aplica",
            "type": "string"
          },
          "request_id": {
            "description": "El mismo valor de `X-Request-ID`",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Identificador del error; no tiene por qué resolver",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "codigo",
          "request_id"
        ],
        "type": "object"
      },
      "ResultadoValidacionRespuesta": {
        "properties": {
          "advertencias": {
            "items": {
              "type": "string"
            },
            "title": "Advertencias",
            "type": "array"
          },
          "apta": {
            "title": "Apta",
            "type": "boolean"
          },
          "motivos": {
