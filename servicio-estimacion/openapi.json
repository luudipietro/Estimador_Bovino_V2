              "no_disponible"
            ],
            "title": "Estado",
            "type": "string"
          },
          "instancias": {
            "description": "Instancias del modelo cargadas (una por hilo de inferencia)",
            "title": "Instancias",
            "type": "integer"
          },
          "modelo_cargado": {
            "title": "Modelo Cargado",
            "type": "boolean"
          },
          "version_modelo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Modelo"
          }
        },
        "required": [
          "estado",
          "modelo_cargado",
          "version_modelo",
          "instancias",
          "error"
        ],
        "title": "Salud",
        "type": "object"
      },
