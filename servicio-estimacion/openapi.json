          "motivos",
          "advertencias"
        ],
        "title": "ResultadoValidacionRespuesta",
        "type": "object"
      },
      "Salud": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
