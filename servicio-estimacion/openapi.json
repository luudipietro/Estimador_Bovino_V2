          },
          "confiable": {
            "title": "Confiable",
            "type": "boolean"
          },
          "creado": {
            "format": "date-time",
            "title": "Creado",
            "type": "string"
          },
          "duracion_ms": {
            "$ref": "#/components/schemas/DuracionMs"
          },
          "estado": {
            "const": "completado",
            "title": "Estado",
            "type": "string"
          },
          "finalizado": {
            "format": "date-time",
            "title": "Finalizado",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "id_evento": {
            "title": "Id Evento",
            "type": "string"
          },
          "imagenes": {
            "items": {
              "$ref": "#/components/schemas/ImagenResultado"
            },
            "title": "Imagenes",
            "type": "array"
          },
          "metadatos": {
            "additionalProperties": true,
            "description": "Se devuelven tal cual llegaron (R-26)",
            "title": "Metadatos",
            "type": "object"
          },
          "motivos": {
            "items": {
              "$ref": "#/components/schemas/MotivoNoSe"
            },
            "title": "Motivos",
