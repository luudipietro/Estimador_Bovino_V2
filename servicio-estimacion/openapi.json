          },
          "peso_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`null` cuando el modelo no puede estimar (R-21)",
            "title": "Peso Kg"
          },
          "rango_validez_kg": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Rango Validez Kg",
            "type": "array"
          },
