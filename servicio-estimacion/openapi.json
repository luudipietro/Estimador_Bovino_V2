  "info": {
    "title": "BovinoVision · Servicio de estimación de peso",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/salud": {
      "get": {
        "description": "La única ruta sin autenticación. Con el arranque normal el modelo siempre está cargado (la app no arranca sin\nél), pero si no lo estuviera esto lo dice en vez de mentir.",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            },
            "description": "El modelo no está disponible"
          }
        },
        "summary": "Liveness y readiness",
        "tags": [
          "salud"
        ]
      }
    },
    "/v1/estimaciones": {
      "post": {
        "description": "Valida el pedido en el borde y lo deja en cola. **202** para un trabajo nuevo; **200** si el `id_evento` ya\nexistía con las mismas imágenes (en cualquier orden), con el estado actual del trabajo existente.",
        "operationId": "crear_v1_estimaciones_post",
        "parameters": [
          {
            "description": "El `id_evento`",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "El `id_evento`",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "metadatos": {
                    "description": "Vuelve sin modificar (R-26).",
                    "type": "object"
                  },
                  "referencias_imagen": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "sha256": {
                          "pattern": "^[0-9a-fA-F]{64}$",
                          "type": "string"
                        },
                        "url": {
                          "description": "https, host en la allowlist",
                          "format": "uri",
                          "type": "string"
                        }
                      },
                      "required": [
                        "url",
                        "sha256"
                      ],
                      "type": "object"
                    },
                    "maxItems": 4,
                    "minItems": 1,
                    "type": "array"
                  },
                  "url_notificacion": {
                    "description": "Host en la allowlist",
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "referencias_imagen"
                ],
                "type": "object"
              }
            },
            "multipart/form-data": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "imagenes": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "maxItems": 4,
                    "minItems": 1,
                    "type": "array"
                  },
                  "metadatos": {
                    "description": "Un objeto JSON. Vuelve sin modificar (R-26).",
                    "type": "string"
                  },
                  "url_notificacion": {
                    "description": "Host en la allowlist",
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "imagenes"
                ],
                "type": "object"
              }
            }
          },
          "description": "Dos formas, mutuamente excluyentes: **multipart/form-data** con 1 a 4 archivos en `imagenes`, o **application/json** con 1 a 4 `referencias_imagen` (URL firmada y SHA-256). Máximo 64 KB de JSON.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrabajoAceptado"
                }
              }
            },
            "description": "El `id_evento` ya existía con las mismas imágenes"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrabajoAceptado"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Pedido mal formado (`solicitud_invalida`)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Falta el token de servicio o no es válido (`no_autenticado`)"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "El `id_evento` ya se usó con otras imágenes (`id_evento_en_conflicto`)"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "La imagen o el pedido supera el tamaño máximo (`imagen_muy_grande`)"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Formato de imagen no admitido (`formato_no_admitido`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Entrada inválida: `imagen_corrupta`, `resolucion_insuficiente`, `cantidad_imagenes_invalida` o `referencia_no_permitida`"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Error interno (`error_interno`)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "`cola_llena` (con `Retry-After`) o `modelo_no_disponible`"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Solicita una estimación",
        "tags": [
          "estimaciones"
        ]
      }
    },
    "/v1/estimaciones/{id_trabajo}": {
      "get": {
        "description": "Devuelve **exactamente** los mismos bytes que se envían por callback.",
        "operationId": "consultar_v1_estimaciones__id_trabajo__get",
        "parameters": [
          {
            "in": "path",
            "name": "id_trabajo",
            "required": true,
            "schema": {
              "title": "Id Trabajo",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "completado": "#/components/schemas/TrabajoCompletado",
                      "fallido": "#/components/schemas/TrabajoFallido",
                      "pendiente": "#/components/schemas/TrabajoEnCurso",
                      "procesando": "#/components/schemas/TrabajoEnCurso"
                    },
                    "propertyName": "estado"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TrabajoEnCurso"
                    },
                    {
                      "$ref": "#/components/schemas/TrabajoCompletado"
                    },
                    {
                      "$ref": "#/components/schemas/TrabajoFallido"
                    }
                  ],
                  "title": "Response Consultar V1 Estimaciones  Id Trabajo  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Falta el token de servicio o no es válido (`no_autenticado`)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "El trabajo no existe o ya venció (`trabajo_no_encontrado`)"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Error interno (`error_interno`)"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Estado y resultado de una estimación",
        "tags": [
          "estimaciones"
        ]
      }
    },
    "/v1/modelo": {
      "get": {
        "operationId": "modelo_v1_modelo_get",
        "responses": {
          "200": {
            "content": {
